{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/RecipeBookLog-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MSSQLRecipeBook": "Server=localhost\\SQLEXPRESS;Database=RecipeBook;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "RecipeImages": "../Infrastructure/RecipeImages"
}
